{
  "name": "fcp-sfd-object-processor",
  "version": "0.2.0",
  "description": "File upload and processing service for Single Front Door",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.10"
  },
  "scripts": {
    "docker:debug": "docker compose -f compose.yaml -f compose.debug.yaml -p 'fcp-sfd-object-processor' up",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up",
    "docker:dev:d": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:stop:v": "docker compose down -v",
    "docker:test": "npm run lint && (mkdir -p coverage/.tmp 2>/dev/null || true) && docker compose -p fcp-sfd-object-processor-test down -v && docker compose -f compose.yaml -f compose.test.yaml -p fcp-sfd-object-processor-test run --build --rm fcp-sfd-object-processor",
    "docker:test:watch": "docker compose -p fcp-sfd-object-processor-test down -v && docker compose -f compose.yaml -f compose.test.yaml -f compose.test.watch.yaml -p fcp-sfd-object-processor-test run --build --rm fcp-sfd-object-processor",
    "generateOpenApiSpec": "node --experimental-vm-modules ./scripts/generate-openapi.js",
    "sonar": "node scripts/sonar-scan.js",
    "pretest": "npm run lint",
    "test": "rm -rf ./coverage/** && vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "npx eslint . --ext .js",
    "lint:fix": "npx eslint . --ext .js --fix",
    "start:watch": "node --watch-path=./src --experimental-vm-modules --inspect=0.0.0.0 src/index.js",
    "start:debug": "node --watch-path=./src --experimental-vm-modules --inspect-brk=0.0.0.0 src/index.js",
    "start": "node --experimental-vm-modules src/index.js",
    "check:synthetic-ids": "sfd-id-check --staged",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "overrides": {
    "@hapi/content": "6.0.3",
    "@defra/fcp-audit-publisher": {
      "joi": "17.13.9"
    },
    "handlebars": "4.7.10",
    "@hapi/jwt": {
      "joi": "17.13.9"
    },
    "hapi-pulse": {
      "joi": "17.13.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "author": "Defra DDTS",
  "contributors": [
    "Amirs Ishmuhametovs <amirs.ishmuhametovs@defra.gov.uk>",
    "Simon Dunn <simon.dunn1@defra.gov.uk>",
    "Rana Salem <rana.salem@defra.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-sns": "3.1161.0",
    "@aws-sdk/credential-providers": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/fcp-audit-publisher": "1.0.9",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@fetchkit/ffetch": "5.5.4",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.12",
    "@hapi/inert": "7.1.3",
    "@hapi/jwt": "3.2.4",
    "@hapi/vision": "7.0.3",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "global-agent": "3.0.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "hapi-swagger": "17.3.2",
    "http-status-codes": "2.3.0",
    "https-proxy-agent": "7.0.5",
    "joi": "17.13.9",
    "mongo-locks": "3.0.2",
    "mongodb": "6.10.0",
    "node-fetch": "3.3.2",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@fetchkit/chaos-fetch": "1.3.0",
    "@types/convict": "6.1.6",
    "@types/node": "26.6.6",
    "@types/webpack-assets-manifest": "6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "fcp-sfd-core": "github:DEFRA/fcp-sfd-core#95f58ade56b2d0dd0f15bdcba6a5f37a54bcc939",
    "husky": "9.1.7",
    "neostandard": "0.14.1",
    "npm-run-all": "4.1.5",
    "vitest": "5.0.5"
  }
}
